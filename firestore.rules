rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // EXAMS: Baca butuh auth (guru/siswa), Tulis hanya guru
    match /exams/{examCode} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // RESULTS: Buat hasil baru, baca/hapus hanya guru
    match /results/{resultId} {
      allow create: if true;
      allow read, delete: if request.auth != null;
      allow update: if false;
    }

    // PARTICIPANTS: Tulis dan baca butuh auth
    match /participants/{docId} {
      allow read, write: if request.auth != null;
    }

    // PERMISSION REQUESTS: Buat publik, baca/update/delete hanya guru
    match /permissionRequests/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // CONFIG: Hanya guru
    match /config/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
